# Nie echte Tokens oder API-Schlüssel committen.
TELEGRAM_BOT_TOKEN=
# Kommagetrennte Telegram-User-IDs, die Bot-Adminbefehle nutzen dürfen
ADMIN_IDS=
# Telegram-Chat-ID des privaten Adminraums
ADMIN_ROOM_ID=0

# gemini oder ollama; bei Ausfall wird automatisch auf den anderen Anbieter gewechselt
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_TIMEOUT_SECONDS=25

NASA_API_KEY=DEMO_KEY
DATABASE_PATH=drhousebot.sqlite3
LOG_LEVEL=INFO
